# PlatformIO build output
.pio/

# PlatformIO / clangd generated databases
compile_commands.json

# VSCode — generated IntelliSense and browse databases.
# These are regenerated by PlatformIO after each build and are machine
# specific (absolute paths), so they must not be committed.
.vscode/c_cpp_properties.json
.vscode/.browse.c_cpp.db*
.vscode/ipch
.vscode/settings.json.bak

# launch.json is hand-authored for this project (DFU cannot debug, so PlatformIO
# does not generate it). It uses ${workspaceFolder}/${env:HOME} and is safe to
# commit — keep it tracked.

# Build artifacts
*.o
*.d
*.elf
*.bin
*.hex
*.map
*.lst
*.su

# DFU tooling
*.dfu

# Python (host dashboard / calibration scripts)
__pycache__/
*.py[cod]
.venv/
venv/

# OS noise
.DS_Store
Thumbs.db
*~
# Host unit-test binary
test/host/esc_test
